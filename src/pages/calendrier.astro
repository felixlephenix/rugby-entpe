---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Calendrier">
  <section class="mx-auto max-w-5xl px-4 py-16">
    <div class="flex items-center justify-between">
      <h1 class="text-3xl font-extrabold">Calendrier</h1>
      <button id="export-season" class="hidden text-sm font-semibold text-bs-navy underline">
        Exporter toute la saison (.ics)
      </button>
    </div>
    <ul id="events-list" class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3"></ul>
  </section>
</Layout>

<script>
  import { supabase } from '../lib/supabase';

  function toIcsDate(date: string, time: string): string {
    return `${date.replace(/-/g, '')}T${time.replace(':', '').padEnd(6, '0')}`;
  }

  function eventToIcs(ev: any): string {
    const start = toIcsDate(ev.date, ev.time);
    return [
      'BEGIN:VEVENT',
      `UID:${ev.id}@rugby-entpe`,
      `DTSTART:${start}`,
      `SUMMARY:${ev.title}${ev.match_details?.[0] ? ' vs ' + ev.match_details[0].opponent : ''}`,
      ev.location ? `LOCATION:${ev.location}` : '',
      ev.note ? `DESCRIPTION:${ev.note}` : '',
      'END:VEVENT',
    ]
      .filter(Boolean)
      .join('\r\n');
  }

  function downloadIcs(filename: string, events: any[]) {
    const body = ['BEGIN:VCALENDAR', 'VERSION:2.0', 'PRODID:-//BlueSharks ENTPE//FR', ...events.map(eventToIcs), 'END:VCALENDAR'].join(
      '\r\n'
    );
    const blob = new Blob([body], { type: 'text/calendar' });
    const link = document.createElement('a');
    link.href = URL.createObjectURL(blob);
    link.download = filename;
    link.click();
  }

  async function main() {
    const { data: events } = await supabase
      .from('events')
      .select('id, title, type, date, time, location, teams, note, status, cancel_reason, match_details(opponent)')
      .gte('date', new Date().toISOString().slice(0, 10))
      .order('date')
      .order('time');

    const list = document.getElementById('events-list')!;

    if (!events || events.length === 0) {
      list.innerHTML = '<li class="py-4 text-slate-500">Aucun événement à venir.</li>';
      return;
    }

    const TYPE_LABELS: Record<string, string> = { match: 'Match', entrainement: 'Entraînement', extra: 'Extra' };
    const STRIPE_CLASS: Record<string, string> = {
      match: 'event-card-stripe-match',
      entrainement: 'event-card-stripe-entrainement',
      extra: 'event-card-stripe-extra',
    };

    list.innerHTML = events
      .map((ev: any) => {
        const match = Array.isArray(ev.match_details) ? ev.match_details[0] : ev.match_details;
        const dateLabel = new Date(`${ev.date}T${ev.time}`).toLocaleString('fr-FR', {
          weekday: 'long',
          day: 'numeric',
          month: 'long',
          hour: '2-digit',
          minute: '2-digit',
        });
        const cancelled = ev.status === 'cancelled';
        const badgeClass = cancelled ? 'badge-annule' : `badge-${ev.type}`;

        return `
          <li class="event-card ${cancelled ? 'opacity-60' : ''}">
            <div class="event-card-stripe ${STRIPE_CLASS[ev.type] ?? ''}"></div>
            <div class="p-4">
              <p class="text-[11px] text-bs-text/50">${dateLabel} · ${ev.teams.join('/')}</p>
              <p class="mt-1 font-body text-[15px] font-medium ${cancelled ? 'line-through' : ''}">
                ${ev.title}${match ? ' vs ' + match.opponent : ''}
              </p>
              <div class="mt-2 flex flex-wrap items-center gap-2 text-xs text-bs-text/60">
                <span class="badge ${badgeClass}">${cancelled ? 'Annulé' : TYPE_LABELS[ev.type] ?? ev.type}</span>
                ${ev.location ? `<span>${ev.location}</span>` : ''}
              </div>
              ${ev.note ? `<p class="mt-2 text-sm text-bs-text/70">${ev.note}</p>` : ''}
              ${cancelled && ev.cancel_reason ? `<p class="mt-2 text-xs text-bs-text/50">Motif : ${ev.cancel_reason}</p>` : ''}
              ${
                !cancelled
                  ? `<button data-export="${ev.id}" class="mt-3 text-xs font-semibold text-bs-navy underline">Ajouter à mon calendrier</button>`
                  : ''
              }
            </div>
          </li>
        `;
      })
      .join('');

    list.querySelectorAll('[data-export]').forEach((btn) => {
      const id = (btn as HTMLElement).dataset.export;
      const ev = events.find((e: any) => e.id === id);
      btn.addEventListener('click', () => downloadIcs(`${ev.title}.ics`, [ev]));
    });

    const exportSeasonBtn = document.getElementById('export-season')!;
    exportSeasonBtn.classList.remove('hidden');
    exportSeasonBtn.addEventListener('click', () => {
      downloadIcs('saison-rugby-entpe.ics', events.filter((e: any) => e.status !== 'cancelled'));
    });
  }

  main();
</script>
