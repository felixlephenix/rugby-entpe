---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Mon profil">
  <section class="mx-auto max-w-3xl px-4 py-16">
    <div id="loading" class="text-slate-500">Chargement...</div>

    <div id="status-message" class="hidden">
      <div class="flex items-center justify-between">
        <h1 class="text-3xl font-extrabold">Mon profil</h1>
        <button
          id="logout-status"
          type="button"
          class="text-sm font-semibold text-slate-600 underline hover:text-slate-900"
        >
          Déconnexion
        </button>
      </div>
      <p id="status-text" class="mt-6 rounded border border-slate-200 bg-slate-50 p-4 text-slate-700"></p>
    </div>

    <div id="content" class="hidden">
      <div class="flex items-center justify-between">
        <h1 class="text-3xl font-extrabold">Mon profil</h1>
        <button
          id="logout"
          type="button"
          class="text-sm font-semibold text-slate-600 underline hover:text-slate-900"
        >
          Déconnexion
        </button>
      </div>

      <h2 class="mt-8 text-xl font-bold">Photo et bio</h2>

      <div id="avatar-bio-view" class="mt-3 flex items-start gap-4">
        <img
          id="avatar-preview-view"
          src=""
          alt="Photo de profil"
          class="hidden h-20 w-20 rounded-full object-cover"
        />
        <div
          id="avatar-placeholder-view"
          class="flex h-20 w-20 items-center justify-center rounded-full bg-slate-200 text-xs text-slate-500"
        >
          Aucune photo
        </div>
        <div>
          <p id="bio-text" class="max-w-sm text-sm text-slate-700"></p>
          <button
            id="edit-avatar-bio"
            type="button"
            class="mt-2 rounded bg-slate-200 px-3 py-1 text-sm font-semibold hover:bg-slate-300"
          >
            Modifier
          </button>
        </div>
      </div>

      <form id="form-avatar-bio" class="mt-3 hidden max-w-sm space-y-3 text-sm">
        <div class="flex items-center gap-4">
          <img
            id="avatar-preview"
            src=""
            alt="Photo de profil"
            class="hidden h-20 w-20 rounded-full object-cover"
          />
          <div
            id="avatar-placeholder"
            class="flex h-20 w-20 items-center justify-center rounded-full bg-slate-200 text-xs text-slate-500"
          >
            Aucune photo
          </div>
          <div>
            <input id="avatar-input" type="file" accept="image/*" class="text-sm" />
            <button
              id="delete-avatar"
              type="button"
              class="mt-2 hidden text-xs font-semibold text-red-600 underline"
            >
              Supprimer la photo
            </button>
          </div>
        </div>
        <label class="block">
          Bio
          <textarea
            id="bio"
            name="bio"
            rows="3"
            class="mt-1 w-full rounded border border-slate-300 px-3 py-2"
          ></textarea>
        </label>
        <div class="flex gap-2">
          <button
            type="submit"
            class="rounded bg-blue-900 px-4 py-2 font-semibold text-white transition hover:bg-blue-800"
          >
            Enregistrer
          </button>
          <button
            id="cancel-avatar-bio"
            type="button"
            class="rounded bg-slate-200 px-4 py-2 font-semibold hover:bg-slate-300"
          >
            Annuler
          </button>
        </div>
        <p id="avatar-bio-message" class="text-sm" role="status"></p>
      </form>

      <h2 class="mt-8 text-xl font-bold">Planning de la semaine</h2>
      <div class="mt-1 flex items-center justify-between">
        <p id="week-label" class="text-sm text-slate-500"></p>
        <p class="text-sm text-slate-600">
          Total de points : <span id="total-points" class="font-bold text-blue-900">0</span>
        </p>
      </div>

      <form id="form-planning" class="mt-4 space-y-3"></form>

      <button
        id="submit-plan"
        form="form-planning"
        type="submit"
        class="mt-6 rounded bg-blue-900 px-4 py-2 font-semibold text-white transition hover:bg-blue-800"
      >
        Enregistrer mon planning de la semaine
      </button>
      <p id="plan-message" class="mt-2 text-sm" role="status"></p>

      <h2 class="mt-8 text-xl font-bold">Mon compte</h2>
      <form id="form-password" class="mt-3 max-w-sm space-y-2 text-sm">
        <label class="block">
          Nouveau mot de passe
          <input
            id="new-password"
            name="new-password"
            type="password"
            required
            minlength="8"
            autocomplete="new-password"
            class="mt-1 w-full rounded border border-slate-300 px-3 py-2"
          />
        </label>
        <label class="block">
          Confirmer le mot de passe
          <input
            id="confirm-password"
            name="confirm-password"
            type="password"
            required
            minlength="8"
            autocomplete="new-password"
            class="mt-1 w-full rounded border border-slate-300 px-3 py-2"
          />
        </label>
        <button
          type="submit"
          class="rounded bg-blue-900 px-4 py-2 font-semibold text-white transition hover:bg-blue-800"
        >
          Changer le mot de passe
        </button>
        <p id="password-message" class="text-sm" role="status"></p>
      </form>
    </div>
  </section>
</Layout>

<script>
  import { supabase } from '../lib/supabase';
  import { url } from '../lib/paths';
  import { compressImage } from '../lib/imageCompress';
  import { addPasswordToggle } from '../lib/passwordToggle';

  addPasswordToggle(document.getElementById('new-password') as HTMLInputElement);
  addPasswordToggle(document.getElementById('confirm-password') as HTMLInputElement);

  const DAYS = ['Lundi', 'Mardi', 'Mercredi', 'Jeudi', 'Vendredi', 'Samedi', 'Dimanche'];

  function getMonday(date: Date): string {
    const d = new Date(date);
    const day = d.getDay();
    const diff = d.getDate() - (day === 0 ? 6 : day - 1);
    d.setDate(diff);
    d.setHours(0, 0, 0, 0);
    return d.toISOString().slice(0, 10);
  }

  async function main() {
    const { data: sessionData } = await supabase.auth.getSession();
    if (!sessionData.session) {
      window.location.href = url('/connexion');
      return;
    }
    const userId = sessionData.session.user.id;

    const { data: profile } = await supabase
      .from('profiles')
      .select('status, bio, avatar_path')
      .eq('id', userId)
      .single();

    document.getElementById('logout-status')!.addEventListener('click', async () => {
      await supabase.auth.signOut();
      window.location.href = url('/connexion');
    });

    if (profile?.status !== 'active') {
      const statusMessages: Record<string, string> = {
        pending: 'Ton compte est en attente de validation par le bureau. Tu recevras un accès dès que ce sera fait.',
        ancien: "Ton compte est marqué comme ancien joueur, l'accès au suivi d'entraînement est désactivé.",
        banned: "L'accès à ce compte a été désactivé.",
      };
      document.getElementById('status-text')!.textContent =
        statusMessages[profile?.status ?? 'pending'] ?? 'Compte non actif.';
      document.getElementById('loading')!.classList.add('hidden');
      document.getElementById('status-message')!.classList.remove('hidden');
      return;
    }

    const bioField = document.getElementById('bio') as HTMLTextAreaElement;
    const bioText = document.getElementById('bio-text')!;
    let currentBio = profile?.bio ?? '';
    let currentAvatarUrl = '';

    function renderViewMode() {
      bioText.textContent = currentBio || 'Aucune bio pour le moment.';
      const previewView = document.getElementById('avatar-preview-view') as HTMLImageElement;
      const previewEdit = document.getElementById('avatar-preview') as HTMLImageElement;
      if (currentAvatarUrl) {
        previewView.src = currentAvatarUrl;
        previewView.classList.remove('hidden');
        document.getElementById('avatar-placeholder-view')!.classList.add('hidden');
        previewEdit.src = currentAvatarUrl;
        previewEdit.classList.remove('hidden');
        document.getElementById('avatar-placeholder')!.classList.add('hidden');
        document.getElementById('delete-avatar')!.classList.remove('hidden');
      } else {
        previewView.classList.add('hidden');
        document.getElementById('avatar-placeholder-view')!.classList.remove('hidden');
        previewEdit.classList.add('hidden');
        document.getElementById('avatar-placeholder')!.classList.remove('hidden');
        document.getElementById('delete-avatar')!.classList.add('hidden');
      }
    }

    function enterEditMode() {
      bioField.value = currentBio;
      document.getElementById('avatar-bio-view')!.classList.add('hidden');
      document.getElementById('form-avatar-bio')!.classList.remove('hidden');
    }

    function exitEditMode() {
      (document.getElementById('avatar-input') as HTMLInputElement).value = '';
      document.getElementById('avatar-bio-message')!.textContent = '';
      document.getElementById('avatar-bio-view')!.classList.remove('hidden');
      document.getElementById('form-avatar-bio')!.classList.add('hidden');
    }

    if (profile?.avatar_path) {
      const { data: avatarUrl } = supabase.storage.from('avatars').getPublicUrl(profile.avatar_path);
      currentAvatarUrl = avatarUrl.publicUrl;
    }
    renderViewMode();

    document.getElementById('edit-avatar-bio')!.addEventListener('click', enterEditMode);
    document.getElementById('cancel-avatar-bio')!.addEventListener('click', exitEditMode);

    document.getElementById('delete-avatar')!.addEventListener('click', async () => {
      if (!confirm('Supprimer ta photo de profil ?')) return;
      const avatarBioMessage = document.getElementById('avatar-bio-message')!;
      await supabase.storage.from('avatars').remove([`${userId}/avatar.jpg`]);
      const { error } = await supabase.from('profiles').update({ avatar_path: null }).eq('id', userId);
      if (error) {
        avatarBioMessage.textContent = 'Erreur : ' + error.message;
        return;
      }
      currentAvatarUrl = '';
      renderViewMode();
      avatarBioMessage.textContent = 'Photo supprimée.';
    });

    document.getElementById('form-avatar-bio')!.addEventListener('submit', async (event) => {
      event.preventDefault();
      const avatarBioMessage = document.getElementById('avatar-bio-message')!;
      const fileInput = document.getElementById('avatar-input') as HTMLInputElement;
      const update: Record<string, unknown> = { bio: bioField.value || null };

      if (fileInput.files && fileInput.files[0]) {
        const compressed = await compressImage(fileInput.files[0]);
        const path = `${userId}/avatar.jpg`;
        const { error: uploadError } = await supabase.storage
          .from('avatars')
          .upload(path, compressed, { contentType: 'image/jpeg', upsert: true });
        if (uploadError) {
          avatarBioMessage.textContent = 'Erreur upload photo : ' + uploadError.message;
          return;
        }
        update.avatar_path = path;
      }

      const { error } = await supabase.from('profiles').update(update).eq('id', userId);
      if (error) {
        avatarBioMessage.textContent = 'Erreur : ' + error.message;
        return;
      }

      currentBio = bioField.value;
      if (update.avatar_path) {
        const { data: avatarUrl } = supabase.storage.from('avatars').getPublicUrl(update.avatar_path as string);
        currentAvatarUrl = avatarUrl.publicUrl + '?t=' + Date.now();
      }
      renderViewMode();
      exitEditMode();
    });

    const [{ data: exercises }, { data: pointsRows }] = await Promise.all([
      supabase.from('exercises').select('id, name, category').order('category'),
      supabase.from('points_log').select('points').eq('player_id', userId),
    ]);

    const totalPoints = (pointsRows ?? []).reduce((sum, row) => sum + row.points, 0);
    document.getElementById('total-points')!.textContent = String(totalPoints);

    const weekStart = getMonday(new Date());
    document.getElementById('week-label')!.textContent =
      'Semaine du ' + new Date(weekStart).toLocaleDateString('fr-FR', { day: 'numeric', month: 'long' });

    const { data: existingPlan } = await supabase
      .from('weekly_plans')
      .select('id, planned_sessions(id, day_of_week, exercise_id, note, completed_at)')
      .eq('player_id', userId)
      .eq('week_start', weekStart)
      .maybeSingle();

    const existingByDay = new Map<number, any>();
    for (const session of existingPlan?.planned_sessions ?? []) {
      existingByDay.set(session.day_of_week, session);
    }

    const form = document.getElementById('form-planning')!;
    form.innerHTML = DAYS.map((day, index) => {
      const dayNum = index + 1;
      const existing = existingByDay.get(dayNum);
      const isLocked = Boolean(existing?.completed_at);
      const options = ['<option value="">— Repos —</option>']
        .concat(
          (exercises ?? []).map(
            (ex) =>
              `<option value="${ex.id}" ${existing?.exercise_id === ex.id ? 'selected' : ''}>${ex.name} (${ex.category})</option>`
          )
        )
        .join('');

      return `
        <div class="rounded border border-slate-200 p-4">
          <div class="flex items-center justify-between">
            <label class="font-semibold">${day}</label>
            ${
              existing
                ? isLocked
                  ? '<span class="text-sm font-semibold text-green-700">Fait ✓</span>'
                  : `<button type="button" data-complete="${existing.id}" class="rounded bg-yellow-400 px-3 py-1 text-sm font-semibold text-blue-900 hover:bg-yellow-300">Marquer fait</button>`
                : ''
            }
          </div>
          <select name="exercise-${dayNum}" ${isLocked ? 'disabled' : ''} class="mt-2 w-full rounded border border-slate-300 px-2 py-1">
            ${options}
          </select>
          <input
            type="text"
            name="note-${dayNum}"
            placeholder="Note (optionnel)"
            value="${existing?.note ?? ''}"
            ${isLocked ? 'disabled' : ''}
            class="mt-2 w-full rounded border border-slate-300 px-2 py-1"
          />
        </div>
      `;
    }).join('');

    form.querySelectorAll('[data-complete]').forEach((button) => {
      button.addEventListener('click', async () => {
        const sessionId = (button as HTMLElement).dataset.complete;
        const { error } = await supabase.rpc('complete_session', { session_id: sessionId });
        if (!error) {
          window.location.reload();
        }
      });
    });

    document.getElementById('form-planning')!.addEventListener('submit', async (event) => {
      event.preventDefault();
      const planMessage = document.getElementById('plan-message')!;
      const formData = new FormData(form as HTMLFormElement);

      const sessions = DAYS.map((_, index) => {
        const dayNum = index + 1;
        const exerciseId = formData.get(`exercise-${dayNum}`);
        const note = formData.get(`note-${dayNum}`);
        if (!exerciseId && !note) return null;
        return { day_of_week: dayNum, exercise_id: exerciseId || null, note: note || null };
      }).filter(Boolean);

      const { error } = await supabase.rpc('define_weekly_plan', {
        week_start_date: weekStart,
        sessions,
      });

      if (error) {
        planMessage.textContent = "Erreur lors de l'enregistrement : " + error.message;
        return;
      }

      window.location.reload();
    });

    document.getElementById('logout')!.addEventListener('click', async () => {
      await supabase.auth.signOut();
      window.location.href = url('/connexion');
    });

    document.getElementById('form-password')!.addEventListener('submit', async (event) => {
      event.preventDefault();
      const passwordMessage = document.getElementById('password-message')!;
      const newPassword = (document.getElementById('new-password') as HTMLInputElement).value;
      const confirmPassword = (document.getElementById('confirm-password') as HTMLInputElement).value;

      if (newPassword !== confirmPassword) {
        passwordMessage.textContent = 'Les deux mots de passe ne correspondent pas.';
        return;
      }

      const { error } = await supabase.auth.updateUser({ password: newPassword });
      passwordMessage.textContent = error ? 'Erreur : ' + error.message : 'Mot de passe changé.';
      if (!error) {
        (document.getElementById('form-password') as HTMLFormElement).reset();
      }
    });

    document.getElementById('loading')!.classList.add('hidden');
    document.getElementById('content')!.classList.remove('hidden');
  }

  main();
</script>
