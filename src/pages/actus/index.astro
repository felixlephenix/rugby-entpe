---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Actus">
  <section class="mx-auto max-w-5xl px-4 py-16">
    <h1 class="text-3xl font-extrabold">Actualités</h1>
    <ul id="news-list" class="mt-8 grid gap-6 sm:grid-cols-2"></ul>
  </section>
</Layout>

<script>
  import { supabase } from '../../lib/supabase';
  import { url } from '../../lib/paths';

  async function main() {
    const { data: news } = await supabase
      .from('news')
      .select('id, title, content, tag, created_at')
      .eq('status', 'published')
      .order('created_at', { ascending: false });

    const list = document.getElementById('news-list')!;
    if (!news || news.length === 0) {
      list.innerHTML = '<li class="text-slate-500">Aucune actualité pour le moment.</li>';
      return;
    }

    list.innerHTML = news
      .map(
        (n) => `
          <li class="rounded border border-slate-200 p-6">
            <p class="text-sm text-slate-500">
              ${new Date(n.created_at).toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' })}
              ${n.tag ? ' · ' + n.tag : ''}
            </p>
            <a href="${url('/actus/detail')}?id=${n.id}" class="mt-1 block text-xl font-bold hover:underline">${n.title}</a>
            <p class="mt-2 text-sm text-slate-600">${(n.content ?? '').slice(0, 140)}</p>
          </li>
        `
      )
      .join('');
  }

  main();
</script>
