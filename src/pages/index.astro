---
import Layout from '../layouts/Layout.astro';
import { url } from '../lib/paths';
---

<Layout title="Accueil">
  <section class="bg-bs-navy text-white">
    <div class="mx-auto max-w-5xl px-4 py-24 text-center">
      <h1 class="font-display text-4xl font-medium tracking-tight sm:text-5xl">BlueSharks ENTPE</h1>
      <p class="mt-4 text-lg text-slate-300">
        Rejoignez l'équipe, suivez nos matchs et notre actualité.
      </p>
      <a
        href={url('/contact')}
        class="mt-8 inline-block rounded bg-bs-yellow px-6 py-3 font-semibold text-bs-navy transition hover:bg-bs-yellow/90"
      >
        Nous rejoindre
      </a>
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-4 py-16">
    <div class="flex items-center justify-between">
      <h2 class="text-2xl font-bold">Classement du mois</h2>
      <a href={url('/profil')} class="text-sm font-semibold text-bs-navy underline">
        Accéder à mon profil →
      </a>
    </div>
    <ol id="leaderboard" class="mt-6 divide-y divide-slate-200 rounded border border-slate-200">
      <li class="p-4 text-sm text-slate-500">Chargement du classement...</li>
    </ol>
  </section>

  <section class="mx-auto max-w-5xl px-4 pb-16">
    <h2 class="text-2xl font-bold">Prochains événements</h2>
    <ul id="prochains-events" class="mt-6 grid gap-4 sm:grid-cols-3">
      <li class="text-sm text-slate-500">Chargement...</li>
    </ul>
    <a href={url('/calendrier')} class="mt-6 inline-block text-sm font-semibold text-bs-text underline">
      Voir tout le calendrier →
    </a>
  </section>

  <section class="mx-auto max-w-5xl px-4 pb-16">
    <h2 class="text-2xl font-bold">Dernières actus</h2>
    <ul id="dernieres-actus" class="mt-6 grid gap-4 sm:grid-cols-3">
      <li class="text-sm text-slate-500">Chargement...</li>
    </ul>
    <a href={url('/actus')} class="mt-6 inline-block text-sm font-semibold text-bs-text underline">
      Toutes les actus →
    </a>
  </section>
</Layout>

<script>
  import { supabase } from '../lib/supabase';
  import { url } from '../lib/paths';

  async function loadLeaderboard() {
    const list = document.getElementById('leaderboard')!;
    const { data, error } = await supabase.rpc('get_monthly_leaderboard');

    if (error || !data || data.length === 0) {
      list.innerHTML = '<li class="p-4 text-sm text-slate-500">Aucun point enregistré ce mois-ci pour le moment.</li>';
      return;
    }

    list.innerHTML = data
      .slice(0, 10)
      .map(
        (row: { display_name: string; total_points: number }, index: number) => `
          <li class="flex items-center justify-between p-4">
            <span class="font-semibold">${index + 1}. ${row.display_name}</span>
            <span class="text-bs-navy font-bold">${row.total_points} pts</span>
          </li>
        `
      )
      .join('');
  }

  async function loadUpcomingEvents() {
    const list = document.getElementById('prochains-events')!;

    const { data: events } = await supabase
      .from('events')
      .select('id, title, date, time, location, match_details(opponent)')
      .eq('status', 'active')
      .gte('date', new Date().toISOString().slice(0, 10))
      .order('date')
      .order('time')
      .limit(3);

    if (!events || events.length === 0) {
      list.innerHTML = '<li class="text-sm text-slate-500">Aucun événement programmé pour le moment.</li>';
      return;
    }

    list.innerHTML = events
      .map((ev: any) => {
        const match = Array.isArray(ev.match_details) ? ev.match_details[0] : ev.match_details;
        return `
          <li class="rounded border border-slate-200 p-4">
            <p class="text-sm text-slate-500">
              ${new Date(`${ev.date}T${ev.time}`).toLocaleDateString('fr-FR', { day: 'numeric', month: 'long' })}
            </p>
            <p class="mt-1 font-semibold">${ev.title}${match ? ' vs ' + match.opponent : ''}</p>
            <p class="text-sm text-slate-500">${ev.location ?? ''}</p>
          </li>
        `;
      })
      .join('');
  }

  async function loadDernieresActus() {
    const list = document.getElementById('dernieres-actus')!;

    const { data: news } = await supabase
      .from('news')
      .select('id, title, content, created_at')
      .eq('status', 'published')
      .order('created_at', { ascending: false })
      .limit(3);

    if (!news || news.length === 0) {
      list.innerHTML = '<li class="text-sm text-slate-500">Aucune actualité pour le moment.</li>';
      return;
    }

    list.innerHTML = news
      .map(
        (article) => `
          <li class="rounded border border-slate-200 p-4">
            <p class="text-sm text-slate-500">
              ${new Date(article.created_at).toLocaleDateString('fr-FR', { day: 'numeric', month: 'long' })}
            </p>
            <a href="${url('/actus/detail')}?id=${article.id}" class="mt-1 block font-semibold hover:underline">
              ${article.title}
            </a>
            <p class="mt-1 text-sm text-slate-600">${(article.content ?? '').slice(0, 80)}</p>
          </li>
        `
      )
      .join('');
  }

  loadLeaderboard();
  loadUpcomingEvents();
  loadDernieresActus();
</script>
