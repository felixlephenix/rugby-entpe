---
import Layout from '../../layouts/Layout.astro';
import { url } from '../../lib/paths';
---

<Layout title="Membres">
  <section class="mx-auto max-w-5xl px-4 py-16">
    <div id="loading" class="text-slate-500">Chargement...</div>

    <div id="content" class="hidden">
      <div class="flex items-center justify-between">
        <h1 class="text-3xl font-extrabold">Membres</h1>
        <a href={url('/admin')} class="text-sm font-semibold text-slate-600 underline">← Administration</a>
      </div>

      <div class="mt-6 flex flex-wrap items-center gap-3">
        <input
          id="search"
          type="text"
          placeholder="Rechercher un nom..."
          class="rounded border border-slate-300 px-3 py-2 text-sm"
        />
        <div id="filters" class="flex gap-2 text-sm">
          <button data-filter="all" class="filter-btn rounded px-3 py-1 font-semibold">Tous</button>
          <button data-filter="active" class="filter-btn rounded px-3 py-1 font-semibold">Actif</button>
          <button data-filter="ancien" class="filter-btn rounded px-3 py-1 font-semibold">Ancien joueur</button>
          <button data-filter="pending" class="filter-btn rounded px-3 py-1 font-semibold">En attente</button>
        </div>
      </div>

      <div class="mt-6 overflow-x-auto">
        <table class="w-full border-collapse text-sm">
          <thead>
            <tr class="border-b border-slate-200 text-left text-slate-500">
              <th class="py-2 pr-4">Photo</th>
              <th class="py-2 pr-4">Nom</th>
              <th class="py-2 pr-4">Poste</th>
              <th class="py-2 pr-4">Équipe</th>
              <th class="py-2 pr-4">Promo</th>
              <th class="py-2 pr-4">Rôle</th>
              <th class="py-2 pr-4">Statut</th>
              <th class="py-2 pr-4">Actions</th>
            </tr>
          </thead>
          <tbody id="rows"></tbody>
        </table>
      </div>

      <div class="mt-8 rounded border border-slate-200 p-4">
        <h2 class="font-bold">Créer une invitation</h2>
        <form id="form-invite" class="mt-2 flex flex-wrap items-end gap-3">
          <div>
            <label for="invite-email" class="block text-sm font-medium">Email</label>
            <input
              id="invite-email"
              type="email"
              required
              class="mt-1 rounded border border-slate-300 px-3 py-2 text-sm"
            />
          </div>
          <button type="submit" class="rounded bg-bs-navy px-4 py-2 text-sm font-semibold text-white hover:bg-bs-navy/90">
            Générer le lien
          </button>
        </form>
        <p id="invite-result" class="mt-2 text-sm"></p>
      </div>
    </div>
  </section>
</Layout>

<script>
  import { supabase, type Profile } from '../../lib/supabase';
  import { requireAdmin } from '../../lib/adminGuard';
  import { url } from '../../lib/paths';
  import { avatarUrl } from '../../lib/avatar';

  const ROLE_LABELS: Record<string, string> = {
    joueur: 'Joueur',
    coach: 'Coach',
    bureau: 'Bureau',
    respo_site: 'Respo site',
    super_admin: 'Super admin',
  };

  const STATUS_LABELS: Record<string, string> = {
    pending: 'En attente',
    active: 'Actif',
    ancien: 'Ancien',
    banned: 'Banni',
  };

  let allProfiles: Profile[] = [];
  let currentFilter = 'all';
  const editingIds = new Set<string>();

  function render() {
    const search = (document.getElementById('search') as HTMLInputElement).value.trim().toLowerCase();

    const filtered = allProfiles.filter((p) => {
      if (currentFilter === 'active' && p.status !== 'active') return false;
      if (currentFilter === 'ancien' && p.status !== 'ancien') return false;
      if (currentFilter === 'pending' && p.status !== 'pending') return false;
      if (search) {
        const fullName = `${p.first_name} ${p.last_name}`.toLowerCase();
        if (!fullName.includes(search)) return false;
      }
      return true;
    });

    const rows = document.getElementById('rows')!;
    rows.innerHTML = filtered
      .map((p) => {
        const isSuperAdmin = p.role === 'super_admin';
        const isEditing = editingIds.has(p.id);
        const roleOptions = Object.entries(ROLE_LABELS)
          .filter(([value]) => value !== 'super_admin')
          .map(([value, label]) => `<option value="${value}" ${p.role === value ? 'selected' : ''}>${label}</option>`)
          .join('');

        const positionCell = isEditing
          ? `<input data-field="position" value="${p.position ?? ''}" class="w-28 rounded border border-slate-200 px-2 py-1" />`
          : p.position || '—';

        const teamCell = isEditing
          ? `<select data-field="default_team" class="rounded border border-slate-200 px-2 py-1">
               <option value="">—</option>
               <option value="E1" ${p.default_team === 'E1' ? 'selected' : ''}>E1</option>
               <option value="E2" ${p.default_team === 'E2' ? 'selected' : ''}>E2</option>
             </select>`
          : p.default_team || '—';

        const promoCell = isEditing
          ? `<input data-field="promo" type="number" value="${p.promo ?? ''}" class="w-20 rounded border border-slate-200 px-2 py-1" />`
          : p.promo || '—';

        const roleCell = isSuperAdmin
          ? 'Super admin'
          : isEditing
            ? `<select data-field="role" class="rounded border border-slate-200 px-2 py-1">${roleOptions}</select>`
            : ROLE_LABELS[p.role];

        const pendingActions =
          p.status === 'pending'
            ? `<button data-approve="${p.id}" class="rounded bg-bs-yellow px-2 py-1 font-semibold text-bs-navy hover:bg-bs-yellow/90">Valider</button>
               <button data-reject="${p.id}" class="rounded bg-slate-200 px-2 py-1 hover:bg-slate-300">Rejeter</button>`
            : '';

        const editActions = isEditing
          ? `<button data-save="${p.id}" class="rounded bg-bs-navy px-2 py-1 font-semibold text-white hover:bg-bs-navy/90">Enregistrer</button>
             ${
               !isSuperAdmin && p.status === 'active'
                 ? `<button data-mark-ancien="${p.id}" class="rounded bg-slate-200 px-2 py-1 hover:bg-slate-300">Marquer ancien</button>`
                 : ''
             }`
          : `<button data-edit="${p.id}" class="rounded bg-slate-200 px-2 py-1 hover:bg-slate-300">Modifier</button>
             ${
               !isSuperAdmin
                 ? `<button data-delete="${p.id}" class="rounded bg-red-600 px-2 py-1 font-semibold text-white hover:bg-red-500">Supprimer</button>`
                 : ''
             }`;

        const photoCell = `
          <div class="flex flex-col items-center gap-1">
            <img src="${avatarUrl(p)}" alt="" class="h-10 w-10 rounded-full object-cover" />
            ${
              p.avatar_path
                ? `<button data-delete-avatar="${p.id}" class="text-[11px] font-semibold text-red-600 underline">Supprimer</button>`
                : ''
            }
          </div>
        `;

        return `
          <tr class="border-b border-slate-100" data-row="${p.id}">
            <td class="py-2 pr-4">${photoCell}</td>
            <td class="py-2 pr-4">
              <a href="${url('/joueur')}?id=${p.id}" class="text-bs-navy underline hover:no-underline">
                ${p.first_name} ${p.last_name}
              </a>
            </td>
            <td class="py-2 pr-4">${positionCell}</td>
            <td class="py-2 pr-4">${teamCell}</td>
            <td class="py-2 pr-4">${promoCell}</td>
            <td class="py-2 pr-4">${roleCell}</td>
            <td class="py-2 pr-4">${STATUS_LABELS[p.status]}</td>
            <td class="py-2 pr-4 space-x-2 whitespace-nowrap">${pendingActions}${editActions}</td>
          </tr>
        `;
      })
      .join('');

    rows.querySelectorAll('[data-approve]').forEach((btn) =>
      btn.addEventListener('click', async () => {
        const id = (btn as HTMLElement).dataset.approve;
        await supabase.from('profiles').update({ status: 'active' }).eq('id', id);
        await load();
      })
    );

    rows.querySelectorAll('[data-reject]').forEach((btn) =>
      btn.addEventListener('click', async () => {
        const id = (btn as HTMLElement).dataset.reject;
        if (!confirm('Rejeter et supprimer cette inscription ?')) return;
        await supabase.rpc('reject_pending_profile', { target_id: id });
        await load();
      })
    );

    rows.querySelectorAll('[data-mark-ancien]').forEach((btn) =>
      btn.addEventListener('click', async () => {
        const id = (btn as HTMLElement).dataset.markAncien!;
        await supabase.from('profiles').update({ status: 'ancien' }).eq('id', id);
        editingIds.delete(id);
        await load();
      })
    );

    rows.querySelectorAll('[data-delete]').forEach((btn) =>
      btn.addEventListener('click', async () => {
        const id = (btn as HTMLElement).dataset.delete;
        if (!confirm('Supprimer définitivement ce compte ? Cette action est irréversible.')) return;
        await supabase.rpc('admin_delete_profile', { target_id: id });
        await load();
      })
    );

    rows.querySelectorAll('[data-delete-avatar]').forEach((btn) =>
      btn.addEventListener('click', async () => {
        const id = (btn as HTMLElement).dataset.deleteAvatar!;
        if (!confirm('Supprimer la photo de profil de ce membre ?')) return;
        await supabase.storage.from('avatars').remove([`${id}/avatar.jpg`]);
        const { error } = await supabase.from('profiles').update({ avatar_path: null }).eq('id', id);
        if (error) alert('Erreur : ' + error.message);
        await load();
      })
    );

    rows.querySelectorAll('[data-edit]').forEach((btn) =>
      btn.addEventListener('click', () => {
        const id = (btn as HTMLElement).dataset.edit!;
        editingIds.add(id);
        render();
      })
    );

    rows.querySelectorAll('[data-save]').forEach((btn) =>
      btn.addEventListener('click', async () => {
        const id = (btn as HTMLElement).dataset.save!;
        const row = rows.querySelector(`tr[data-row="${id}"]`)!;
        const position = (row.querySelector('[data-field="position"]') as HTMLInputElement).value || null;
        const defaultTeam = (row.querySelector('[data-field="default_team"]') as HTMLSelectElement).value || null;
        const promoValue = (row.querySelector('[data-field="promo"]') as HTMLInputElement).value;
        const roleField = row.querySelector('[data-field="role"]') as HTMLSelectElement | null;

        const update: Record<string, unknown> = {
          position,
          default_team: defaultTeam,
          promo: promoValue ? Number(promoValue) : null,
        };
        if (roleField) update.role = roleField.value;

        const { error } = await supabase.from('profiles').update(update).eq('id', id);
        if (error) {
          alert('Erreur : ' + error.message);
          return;
        }
        editingIds.delete(id);
        await load();
      })
    );
  }

  async function load() {
    const { data } = await supabase
      .from('profiles')
      .select('*')
      .order('first_name');
    allProfiles = (data ?? []) as Profile[];
    render();
  }

  async function main() {
    const profile = await requireAdmin();
    if (!profile) return;

    document.getElementById('search')!.addEventListener('input', render);

    document.querySelectorAll('.filter-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        currentFilter = (btn as HTMLElement).dataset.filter!;
        document.querySelectorAll('.filter-btn').forEach((b) => b.classList.remove('bg-bs-navy', 'text-white'));
        btn.classList.add('bg-bs-navy', 'text-white');
        render();
      });
    });
    document.querySelector('.filter-btn[data-filter="all"]')!.classList.add('bg-bs-navy', 'text-white');

    document.getElementById('form-invite')!.addEventListener('submit', async (event) => {
      event.preventDefault();
      const email = (document.getElementById('invite-email') as HTMLInputElement).value.trim();
      const { data, error } = await supabase.rpc('create_member_invitation', { invite_email: email });
      const result = document.getElementById('invite-result')!;
      if (error) {
        result.textContent = 'Erreur : ' + error.message;
        return;
      }
      const link = `${window.location.origin}${url('/inscription')}?invitation=${data}`;
      result.innerHTML = `Lien à transmettre : <a class="underline" href="${link}">${link}</a>`;
    });

    await load();

    document.getElementById('loading')!.classList.add('hidden');
    document.getElementById('content')!.classList.remove('hidden');
  }

  main();
</script>
