---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact">
  <section class="mx-auto max-w-3xl px-4 py-16">
    <h1 class="text-3xl font-extrabold">Nous contacter</h1>
    <p class="mt-4 text-slate-600">
      Envie de rejoindre le club ou une question ? Écrivez-nous.
    </p>
    <div class="mt-8 space-y-2 text-slate-700">
      <p><strong>Messenger :</strong> <span id="messenger-contacts">Chargement...</span></p>
      <p><strong>Entraînements :</strong> Lundi à 19h30 à la cage, mardi 12h30 au stade Ladoumègue</p>
      <p><strong>Matchs : Jeudi après-midi</strong></p>
      <p><strong>Adresse :</strong> ENTPE, Vaulx-en-Velin</p>
    </div>
  </section>
</Layout>

<script>
  import { supabase } from '../lib/supabase';

  async function loadMessengerContacts() {
    const target = document.getElementById('messenger-contacts')!;
    const { data: bureau } = await supabase
      .from('profiles')
      .select('first_name, last_name, promo')
      .eq('role', 'bureau')
      .eq('status', 'active')
      .order('first_name');

    if (!bureau || bureau.length === 0) {
      target.textContent = 'Contacte un membre du bureau.';
      return;
    }

    const names = bureau
      .map((p) => `${p.first_name} ${p.last_name}${p.promo ? ' (promo ' + p.promo + ')' : ''}`)
      .join(', ');
    target.textContent = ${names}.`;
  }

  loadMessengerContacts();
</script>
