---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact">
  <section class="mx-auto max-w-3xl px-4 py-16">
    <h1 class="text-3xl font-extrabold">Nous contacter</h1>
    <p class="mt-4 text-slate-600">
      Envie de rejoindre le club ou une question ? Écrivez-nous.
    </p>
    <div class="mt-8 space-y-2 text-slate-700">
      <p><strong>Email :</strong> <a href="mailto:rugby@entpe.fr" class="underline">rugby@entpe.fr</a></p>
      <p><strong>Entraînements :</strong> Lundi à la cage</p>
      <p><strong>Adresse :</strong> ENTPE, Vaulx-en-Velin</p>
    </div>
  </section>
</Layout>
