---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Profil joueur">
  <section class="mx-auto max-w-3xl px-4 py-16">
    <div id="loading" class="text-slate-500">Chargement...</div>
    <div id="not-found" class="hidden text-slate-500">Profil introuvable.</div>

    <div id="content" class="hidden">
      <div class="flex items-start gap-4">
        <img id="avatar" src="" alt="Photo de profil" class="h-24 w-24 rounded-full object-cover" />
        <div>
          <h1 id="name" class="text-3xl font-extrabold"></h1>
          <p id="bureau-post" class="mt-1 hidden text-sm font-semibold text-bs-navy"></p>
          <p id="position-team" class="mt-1 text-sm text-slate-500"></p>
        </div>
      </div>

      <p id="bio" class="mt-6 max-w-xl text-slate-700"></p>

      <div id="planning-section" class="mt-8 hidden">
        <h2 class="text-xl font-bold">Planning de la semaine</h2>
        <p id="week-label" class="mt-1 text-sm text-slate-500"></p>
        <ul id="planning-list" class="mt-4 divide-y divide-slate-200"></ul>
      </div>

      <p id="login-hint" class="mt-8 hidden text-sm text-slate-500">
        Connecte-toi pour voir le planning de ce joueur.
      </p>
    </div>
  </section>
</Layout>

<script>
  import { supabase } from '../lib/supabase';
  import { avatarUrl } from '../lib/avatar';

  const DAYS = ['Lundi', 'Mardi', 'Mercredi', 'Jeudi', 'Vendredi', 'Samedi', 'Dimanche'];

  const BUREAU_POST_LABELS: Record<string, string> = {
    capitaine_e1: 'Capitaine E1',
    capitaine_e2: 'Capitaine E2',
    respo: 'Respo',
  };

  function getMonday(date: Date): string {
    const d = new Date(date);
    const day = d.getDay();
    const diff = d.getDate() - (day === 0 ? 6 : day - 1);
    d.setDate(diff);
    d.setHours(0, 0, 0, 0);
    return d.toISOString().slice(0, 10);
  }

  async function main() {
    const id = new URLSearchParams(window.location.search).get('id');
    if (!id) {
      document.getElementById('loading')!.classList.add('hidden');
      document.getElementById('not-found')!.classList.remove('hidden');
      return;
    }

    const { data: profile } = await supabase
      .from('profiles')
      .select('first_name, last_name, position, default_team, bio, avatar_path, status, role, promo, role_bureau')
      .eq('id', id)
      .maybeSingle();

    document.getElementById('loading')!.classList.add('hidden');

    if (!profile) {
      document.getElementById('not-found')!.classList.remove('hidden');
      return;
    }

    document.getElementById('name')!.textContent = `${profile.first_name} ${profile.last_name}`;
    if (profile.role_bureau && BUREAU_POST_LABELS[profile.role_bureau]) {
      const bureauPostEl = document.getElementById('bureau-post')!;
      bureauPostEl.textContent = BUREAU_POST_LABELS[profile.role_bureau];
      bureauPostEl.classList.remove('hidden');
    }
    document.getElementById('position-team')!.textContent = [
      profile.position,
      profile.default_team,
      profile.promo ? `Promo ${profile.promo}` : null,
    ]
      .filter(Boolean)
      .join(' · ') || 'Informations non renseignées';
    document.getElementById('bio')!.textContent = profile.bio || 'Aucune bio pour le moment.';

    (document.getElementById('avatar') as HTMLImageElement).src = avatarUrl(profile);

    const { data: sessionData } = await supabase.auth.getSession();
    if (!sessionData.session) {
      document.getElementById('login-hint')!.classList.remove('hidden');
      document.getElementById('content')!.classList.remove('hidden');
      return;
    }

    const weekStart = getMonday(new Date());
    document.getElementById('week-label')!.textContent =
      'Semaine du ' + new Date(weekStart).toLocaleDateString('fr-FR', { day: 'numeric', month: 'long' });

    const { data: existingPlan } = await supabase
      .from('weekly_plans')
      .select('id, planned_sessions(id, day_of_week, exercise_id, note, completed_at, exercises(name, category))')
      .eq('player_id', id)
      .eq('week_start', weekStart)
      .maybeSingle();

    const existingByDay = new Map<number, any>();
    for (const session of existingPlan?.planned_sessions ?? []) {
      existingByDay.set(session.day_of_week, session);
    }

    const list = document.getElementById('planning-list')!;
    list.innerHTML = DAYS.map((day, index) => {
      const dayNum = index + 1;
      const existing = existingByDay.get(dayNum);
      const exercise = existing?.exercises;

      return `
        <li class="flex items-center justify-between py-3">
          <div>
            <p class="font-semibold">${day}</p>
            <p class="text-sm text-slate-500">
              ${exercise ? `${exercise.name} (${exercise.category})` : existing ? 'Séance libre' : 'Repos'}
              ${existing?.note ? ' — ' + existing.note : ''}
            </p>
          </div>
          ${existing?.completed_at ? '<span class="text-sm font-semibold text-green-700">Fait ✓</span>' : ''}
        </li>
      `;
    }).join('');

    document.getElementById('planning-section')!.classList.remove('hidden');
    document.getElementById('content')!.classList.remove('hidden');
  }

  main();
</script>
