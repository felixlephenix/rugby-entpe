---
import { url } from '../lib/paths';

const links = [
  { href: '/', label: 'Accueil' },
  { href: '/equipes', label: 'Équipes' },
  { href: '/calendrier', label: 'Calendrier' },
  { href: '/actus', label: 'Actus' },
  { href: '/contact', label: 'Contact' },
];
const currentPath = Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ''), '') || '/';
---

<header class="bg-slate-900 text-white">
  <div class="mx-auto flex max-w-5xl items-center justify-between px-4 py-4">
    <a href={url('/')} class="text-xl font-bold tracking-wide">Rugby ENTPE</a>
    <nav>
      <ul class="flex gap-6 text-sm font-medium">
        {links.map((link) => (
          <li>
            <a
              href={url(link.href)}
              class:list={[
                'transition hover:text-amber-400',
                currentPath === link.href && 'text-amber-400',
              ]}
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>
