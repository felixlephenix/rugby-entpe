---
import { url } from '../lib/paths';

const links = [
  { href: '/', label: 'Accueil' },
  { href: '/equipes', label: 'Équipes' },
  { href: '/calendrier', label: 'Calendrier' },
  { href: '/actus', label: 'Actus' },
  { href: '/contact', label: 'Contact' },
  { href: '/tableau-de-bord', label: 'Mon planning' },
];
const currentPath = Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ''), '') || '/';
---

<header class="bg-blue-900 text-white">
  <div class="mx-auto flex max-w-5xl items-center justify-between px-4 py-4">
    <a href={url('/')} class="text-xl font-bold tracking-wide">Rugby ENTPE</a>
    <nav>
      <ul class="flex gap-6 text-sm font-medium">
        {links.map((link) => (
          <li>
            <a
              href={url(link.href)}
              class:list={[
                'transition hover:text-yellow-400',
                currentPath === link.href && 'text-yellow-400',
              ]}
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <a
      id="admin-link"
      href={url('/admin')}
      class="hidden text-sm font-semibold text-yellow-400 hover:underline"
    >
      Administration
    </a>
  </div>
</header>

<script>
  import { supabase, isAdminRole } from '../lib/supabase';

  async function showAdminLinkIfAllowed() {
    const { data: sessionData } = await supabase.auth.getSession();
    if (!sessionData.session) return;

    const { data: profile } = await supabase
      .from('profiles')
      .select('role, status')
      .eq('id', sessionData.session.user.id)
      .single();

    if (profile && profile.status === 'active' && isAdminRole(profile.role)) {
      document.getElementById('admin-link')?.classList.remove('hidden');
    }
  }

  showAdminLinkIfAllowed();
</script>
