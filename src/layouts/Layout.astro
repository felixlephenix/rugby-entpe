---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { url } from '../lib/paths';

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Site officiel du club de rugby de l'ENTPE" } = Astro.props;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/jpeg" href={url('/logo.jpg')} />
    <title>{title} · BlueSharks ENTPE</title>
  </head>
  <body class="flex min-h-screen flex-col bg-bs-bg font-body text-bs-text">
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
